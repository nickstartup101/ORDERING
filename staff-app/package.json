{
  "name": "ordering-staff",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync:web": "node -e \"const fs=require('fs'); ['css/style.css','js/config.js','js/dialog.js','js/audio.js','js/staff.js'].forEach(f=>fs.copyFileSync('../web/'+f,'www/'+f));\"",
    "cap:sync": "npm run sync:web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
